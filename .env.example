# 环境变量示例 / Environment variables example
# 用法：复制为 .env 后修改 / Usage: copy to .env and edit
#   cp .env.example .env

# ===== 必须修改 / REQUIRED =====

# 数据库连接串 / Database URL
# 格式 / Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/fsp_exam

# JWT 签名与 Session 加密密钥，禁止使用占位符 / JWT & session secret key, never keep the placeholder
# 生成方式 / Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-random-secret-key>

# ===== 可选 / OPTIONAL（不设置则用括号内默认值 / defaults in parentheses apply when omitted）=====

# 全局日志级别 / Global log level: DEBUG/INFO/WARNING/ERROR/CRITICAL (INFO)
LOG_LEVEL=INFO

# 日志文件目录；留空只输出到 stdout，多 worker 部署建议留空交由 systemd/Docker 收集
# Log dir; empty = stdout only. Keep empty with multiple workers and let the process manager collect it
LOG_DIR=

# 日志文件保留天数，仅在设置 LOG_DIR 后生效 / Log retention days, only used when LOG_DIR is set (7)
LOG_FILE_BACKUP_DAYS=7

# SQLAlchemy 日志级别，设为 INFO 可打印所有 SQL / SQLAlchemy log level, INFO prints all SQL (WARNING)
LOG_SQL_LEVEL=WARNING
